# ═══════════════════════════════════════════════════════════════════
#  Configuración del backend
#  Copia este archivo como .env y ajusta los valores.
#  El archivo .env NUNCA se sube al repositorio: contiene secretos.
# ═══════════════════════════════════════════════════════════════════

# ── Servidor ──
PUERTO=3001

# ── Base de datos ──
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=bpm_app
BD_CLAVE=cambiar-esta-clave
BD_NOMBRE=bpm_contact

# ── Seguridad ──
# Cadena larga y aleatoria para firmar los tokens de sesión.
# Generar con: openssl rand -base64 48
JWT_SECRETO=cambiar-por-una-cadena-larga-y-aleatoria
JWT_HORAS=8

# ── Central telefónica ──
# Datos que el backend entrega al navegador junto con la credencial.
PBX_WSS=wss://vitalpbx.bpmconsulting.com.co:8089/ws
PBX_DOMINIO=vitalpbx.bpmconsulting.com.co
PBX_ICE=stun:stun.l.google.com:19302

# Clave SIP provisional, la misma para todas las extensiones.
# Se usa mientras no exista integración con la API de VitalPBX.
PBX_CLAVE_FIJA=

# ── API de VitalPBX (opcional, para crear extensiones) ──
VITALPBX_URL=
VITALPBX_APIKEY=

# ── Orígenes permitidos, separados por coma ──
CORS_ORIGENES=http://localhost:8080,http://localhost:3000
